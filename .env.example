# HK ENV. WEB-APP — environment variables
# Copy this file to .env.local and fill in real values for your machine.
# HK IT: see README.md "For HK IT" section for production deployment.

# ---- Database (Prisma / PostgreSQL) ----
# Connection string used by prisma.config.ts for migrations and by the runtime
# adapter (wired in Phase 1) for queries. Swap host/port/db/user/password.
# Prisma supports PostgreSQL, MySQL, SQL Server, SQLite, MongoDB, CockroachDB.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/hkenv?schema=public"

# ---- Auth (wired in Phase 1) ----
# 32+ random bytes, base64 or hex. Generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# ---- Phase 0 developer aid ----
# Flip the role of the stubbed current user so the role-aware UI can be tested
# without real auth. Valid values: OWNER, ADMIN, OPERATOR. Default: OWNER.
# REMOVE this var once Phase 1 auth replaces the stub in src/lib/session.ts.
DEV_STUB_ROLE="OWNER"
