# HK ENV. WEB-APP — environment variables
# Copy this file to .env.local and fill in real values for your machine.
# HK IT: see README.md "For HK IT" section for production deployment.

# ---- Database (Prisma / PostgreSQL) ----
# Used by prisma.config.ts (migrations) AND by the runtime adapter (queries).
# Swap host/port/db/user/password. Prisma supports PostgreSQL, MySQL,
# SQL Server, SQLite, MongoDB, CockroachDB — change provider in
# prisma/schema.prisma to switch.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/hkenv?schema=public"

# ---- Auth ----
# 32+ random bytes used to sign the short-lived pending-login cookie.
# Generate with:   openssl rand -base64 32
AUTH_SECRET=""
# Public origin used to build links inside emails (e.g. password reset).
AUTH_URL="http://localhost:3000"

# ---- Email (password reset) ----
# Optional. When SMTP_HOST is blank, the password-reset email is logged to the
# server console instead of sent. This lets local dev / QA exercise the flow
# without an SMTP provider.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="HK ENV. <no-reply@hkenv.local>"

# ---- Seed (only used by `npm run db:seed`) ----
# Default seed creates one Owner. Override here if you want a different
# initial account. The seed is safe to re-run — it skips if the user exists.
SEED_OWNER_EMAIL="owner@hkenv.local"
SEED_OWNER_NAME="HK Owner"
SEED_OWNER_PASSWORD="ChangeMe!2026"
