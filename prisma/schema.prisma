// HK ENV. WEB-APP — Prisma schema
// Source of truth: proposal.docx (Section 2). Models grow phase-by-phase
// per HK_ENV_WebApp_ClaudeCode_BuildPlan.md.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Prisma 7+ reads the connection URL from prisma.config.ts at migration time
  // and from a runtime adapter at query time. See prisma.config.ts and src/lib/db.ts.
}

// Three operational roles per proposal Section 2.1.
// OWNER  — full access, including exception approvals (Section 2.8).
// ADMIN  — day-to-day management (dispatch, ticket review, users, projects).
// OPERATOR — drivers in the field (accept dispatch, run trips, submit tickets).
enum Role {
  OWNER
  ADMIN
  OPERATOR
}

enum SessionEventType {
  LOGIN
  LOGOUT
}

// Truck equipment types — mirrors the eTicket choices (proposal §2.2).
enum TruckType {
  TRI_AXLE
  END_DUMP
  LIVE_BOTTOM
  FLOAT
}

// MAINTENANCE / INACTIVE trucks are excluded from dispatch (§2.3).
enum TruckStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
}

// Ontario commercial classes; the most common HK uses are AZ/DZ.
// Kept as an enum so the dropdown can't drift; add classes as needed.
enum LicenceClass {
  AZ
  DZ
  BZ
  CZ
  G
}

// Project lifecycle per proposal §2.4. Master dashboard shows ACTIVE.
enum ProjectStatus {
  ACTIVE
  COMPLETED
}

// Operator's response to a dispatch (proposal §2.6 — Accept / Flag Issue).
// Acceptance is visible to admin WITHOUT requiring the operator's location
// at that moment (location is captured separately at Start, Phase 6).
enum DispatchAcceptance {
  PENDING
  ACCEPTED
  FLAGGED
}

// Live haul state shown on the dispatch board (proposal §2.6).
// CANCELLED is admin-only (revoking before Start).
enum DispatchStatus {
  IDLE
  EN_ROUTE_TO_PICKUP
  LOADING
  EN_ROUTE_TO_DUMP
  COMPLETED
  CANCELLED
}

// Owner exception lifecycle per proposal §2.8.
// Auto-raised by the system or admin; resolved by an Owner only.
enum ExceptionStatus {
  PENDING
  APPROVED
  DECLINED
}

enum ExceptionType {
  TICKET_LATE_SUBMISSION   // submitted after the late-submission threshold
  TICKET_FLAGGED           // admin flagged a ticket
  ADMIN_OVERRIDE_REQUEST   // admin requests Owner sign-off explicitly
}

// Digital load ticket lifecycle per proposal §2.2.
// DRAFT  — operator is filling it in (deletable)
// SUBMITTED — signed + locked (never deletable from here on)
// APPROVED — admin stamp + timestamp
// FLAGGED  — admin pushed back; Phase 9 routes to Owner exceptions
enum TicketStatus {
  DRAFT
  SUBMITTED
  APPROVED
  FLAGGED
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  name            String
  role            Role     @default(OPERATOR)
  employeeId      String?  @unique
  isActive        Boolean  @default(true)

  // Auth (Phase 1)
  passwordHash    String
  totpSecret      String?
  totpEnabled     Boolean  @default(false)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  sessions           Session[]
  sessionEvents      SessionEvent[]
  passwordResets     PasswordReset[]
  operator           Operator?
  uploadedDocuments  ProjectDocument[]
  createdDispatches  Dispatch[]
  approvedTickets    Ticket[]          @relation("TicketApprovedBy")
  flaggedTickets     Ticket[]          @relation("TicketFlaggedBy")
  raisedExceptions   Exception[]       @relation("ExceptionCreatedBy")
  decidedExceptions  Exception[]       @relation("ExceptionDecidedBy")
}

// Operator-specific fields, separate from User so only drivers carry phone /
// licence class / photo / current truck. 1:1 with User where role=OPERATOR.
model Operator {
  id            String        @id @default(cuid())
  userId        String        @unique
  phone         String?
  licenceClass  LicenceClass?
  photoPath     String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentTruck  Truck?        @relation("CurrentAssignment")
  assignments   TruckAssignmentEvent[]
  projects      OperatorOnProject[]
  dispatches    Dispatch[]
  trips         Trip[]
  tickets       Ticket[]
}

model Truck {
  id                  String       @id @default(cuid())
  licensePlate        String       @unique
  type                TruckType
  capacityTonnes      Float
  colour              String       // colour and/or ID tag visible from outside
  status              TruckStatus  @default(ACTIVE)
  assignedOperatorId  String?      @unique
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  assignedOperator    Operator?    @relation("CurrentAssignment", fields: [assignedOperatorId], references: [id])
  assignments         TruckAssignmentEvent[]
  projects            TruckOnProject[]
  dispatches          Dispatch[]
  trips               Trip[]
  tickets             Ticket[]
}

model Project {
  id              String        @id @default(cuid())
  name            String
  client          String
  address         String
  startDate       DateTime
  endDate         DateTime?
  materialBudget  Float         // currency (CAD); unit-agnostic per proposal §2.4
  loadTarget      Int           // number of loads to complete
  scheduleNotes   String?       // free-text shift / schedule notes
  status          ProjectStatus @default(ACTIVE)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  operators       OperatorOnProject[]
  trucks          TruckOnProject[]
  documents       ProjectDocument[]
  dispatches      Dispatch[]
  trips           Trip[]
  tickets         Ticket[]

  @@index([status])
}

model Dispatch {
  id            String              @id @default(cuid())
  projectId     String
  operatorId    String              // refs Operator.id
  truckId       String
  scheduledFor  DateTime            // when the haul is planned to run
  pickupNote    String?             // free-text pickup site / address
  dumpNote      String?             // free-text dump site / address
  notes         String?             // free-text admin notes

  // Acceptance — proposal §2.6 ("Accept" or "Flag an Issue")
  acceptance    DispatchAcceptance  @default(PENDING)
  acceptedAt    DateTime?
  flagReason    String?
  flaggedAt     DateTime?

  // Live status — proposal §2.6 dispatch board
  status        DispatchStatus      @default(IDLE)
  startedAt     DateTime?           // Phase 6 wires GPS sampling here
  completedAt   DateTime?
  cancelledAt   DateTime?

  createdById   String
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  project       Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  operator      Operator            @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  truck         Truck               @relation(fields: [truckId], references: [id], onDelete: Cascade)
  createdBy     User                @relation(fields: [createdById], references: [id], onDelete: NoAction)
  trip          Trip?
  ticket        Ticket?
  exceptions    Exception[]

  @@index([scheduledFor])
  @@index([projectId, scheduledFor])
  @@index([operatorId, scheduledFor])
  @@index([truckId])
  @@index([status])
  @@index([acceptance])
}

// GPS trip per proposal §2.5. 1:1 with a dispatch — created on Start,
// finalised when the operator advances to COMPLETED. Denormalises start /
// end coords + point count so the search list doesn't have to join.
model Trip {
  id           String      @id @default(cuid())
  dispatchId   String      @unique
  operatorId   String
  truckId      String
  projectId    String
  startedAt    DateTime    @default(now())
  endedAt      DateTime?

  // Updated as samples arrive — saves the list view from aggregating points.
  startLatitude   Float?
  startLongitude  Float?
  endLatitude     Float?
  endLongitude    Float?
  pointCount      Int      @default(0)
  totalDistanceM  Float?   // sum of segment distances, updated as we go

  // Convenience copies from the dispatch (so trip search by site doesn't
  // need a dispatch join either). Updated on Trip create.
  pickupNote   String?
  dumpNote     String?

  dispatch     Dispatch    @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  operator     Operator    @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  truck        Truck       @relation(fields: [truckId], references: [id], onDelete: Cascade)
  project      Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  points       TripPoint[]

  @@index([operatorId, startedAt])
  @@index([projectId, startedAt])
  @@index([truckId, startedAt])
  @@index([startedAt])
}

// Digital load ticket — mirrors HK's paper ticket layout (proposal §2.2).
// All field names match the paper form for staff familiarity.
model Ticket {
  id                String              @id @default(cuid())
  ticketNumber      String              @unique  // T-NNNNNN, atomic via SystemCounter

  // Header (mirrors the paper ticket)
  date              DateTime            // haul date the ticket is FOR
  brokerName        String?
  truckNumber       String?             // unit number printed on the truck
  licensePlate      String?
  companyHaulingFor String?
  jobContractNumber String?
  pickupLocation    String?
  deliveryLocation  String?
  equipmentType     TruckType
  used407ETR        Boolean             @default(false)

  startTime         DateTime?
  endTime           DateTime?
  totalHours        Float?              // cached from startTime/endTime at submit

  // End-of-haul fields per proposal §2.7 (added Phase 8)
  materialType      String?             // e.g. "Topsoil", "Crushed stone 19mm"
  issuesNote        String?             // operator-reported issues at the dump

  comments          String?

  // Workflow
  status            TicketStatus        @default(DRAFT)
  signatureDataUrl  String?             // base64 PNG of operator's signature
  submittedAt       DateTime?
  approvedAt        DateTime?
  approvedById      String?
  flaggedAt         DateTime?
  flagReason        String?
  flaggedById       String?

  // System context — set on create; immutable thereafter.
  // dispatchId is optional + UNIQUE so a dispatch has at most one ticket;
  // Phase 8 auto-links these when the operator hits "Complete Load".
  dispatchId        String?             @unique
  projectId         String?
  operatorId        String
  truckId           String?

  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  dispatch          Dispatch?           @relation(fields: [dispatchId], references: [id], onDelete: SetNull)
  project           Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  operator          Operator            @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  truck             Truck?              @relation(fields: [truckId], references: [id], onDelete: SetNull)
  approvedBy        User?               @relation("TicketApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  flaggedBy         User?               @relation("TicketFlaggedBy",  fields: [flaggedById], references: [id], onDelete: SetNull)
  loadEntries       TicketLoadEntry[]
  photos            TicketPhoto[]
  exceptions        Exception[]

  @@index([status, date])
  @@index([operatorId, date])
  @@index([projectId, date])
  @@index([truckId, date])
  @@index([date])
}

// Per-load row inside a ticket ("Load 1 at 8:32", "Load 2 at 9:15", ...).
// Proposal §2.2: "per-load count and times".
model TicketLoadEntry {
  id          String   @id @default(cuid())
  ticketId   String
  loadNumber Int
  loadTime   DateTime?
  notes      String?

  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@unique([ticketId, loadNumber])
  @@index([ticketId])
}

// Owner exception per proposal §2.8 — anything that needs Owner sign-off.
// `summary` is a human-readable one-liner shown in the queue; `details`
// holds the longer explanation. The decision side stays null until an
// Owner approves or declines, at which point decidedAt / decidedById /
// decisionNote are set. History is never deleted (accountability).
model Exception {
  id            String          @id @default(cuid())
  type          ExceptionType
  status        ExceptionStatus @default(PENDING)

  summary       String
  details       String?

  // Loose linkage to the entity that triggered this (mostly Ticket today,
  // could expand to Dispatch / Project later). SetNull on parent delete so
  // the audit trail outlives the underlying record.
  ticketId      String?
  dispatchId    String?

  createdById   String?         // null = system-raised
  createdAt     DateTime        @default(now())

  decidedAt     DateTime?
  decidedById   String?
  decisionNote  String?

  ticket        Ticket?         @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  dispatch      Dispatch?       @relation(fields: [dispatchId], references: [id], onDelete: SetNull)
  createdBy     User?           @relation("ExceptionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  decidedBy     User?           @relation("ExceptionDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([type, createdAt])
  @@index([ticketId])
  @@index([dispatchId])
}

// Optional photos attached to an end-of-haul ticket (proposal §2.7).
// Stored under public/uploads/tickets/{ticketId}/{filename}; can only be
// added while DRAFT — once submitted the photo set is frozen with the ticket.
model TicketPhoto {
  id           String   @id @default(cuid())
  ticketId     String
  filename     String
  originalName String
  mimeType     String
  byteSize     Int
  uploadedAt   DateTime @default(now())

  ticket       Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, uploadedAt])
}

// Individual GPS sample from the operator's browser. The browser throttles
// to ~30s / ~200m before posting (configurable in src/components/GpsTracker),
// so we don't end up with thousands of rows per trip.
model TripPoint {
  id          String   @id @default(cuid())
  tripId      String
  recordedAt  DateTime
  latitude    Float
  longitude   Float
  accuracy    Float?
  speed       Float?
  heading     Float?

  trip        Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, recordedAt])
}

// Join table for operators ↔ projects (proposal §2.4: "Assign operators and
// trucks to each project"). When removed, the row is hard-deleted; project
// load counts grouped by operator come from Ticket rows in Phase 7.
model OperatorOnProject {
  projectId   String
  operatorId  String
  assignedAt  DateTime @default(now())

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  operator    Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)

  @@id([projectId, operatorId])
  @@index([operatorId])
}

model TruckOnProject {
  projectId   String
  truckId     String
  assignedAt  DateTime @default(now())

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  truck       Truck    @relation(fields: [truckId], references: [id], onDelete: Cascade)

  @@id([projectId, truckId])
  @@index([truckId])
}

// Document vault per proposal §2.4. File lives under
// public/uploads/projects/{projectId}/{filename}; row holds the metadata
// for listing and download.
model ProjectDocument {
  id           String   @id @default(cuid())
  projectId    String
  filename     String   // stored filename on disk (cuid + ext)
  originalName String   // what the user uploaded
  mimeType     String
  byteSize     Int
  uploadedById String
  uploadedAt   DateTime @default(now())

  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy   User     @relation(fields: [uploadedById], references: [id], onDelete: NoAction)

  @@index([projectId, uploadedAt])
}

// Audit trail for assignment changes. The current row (releasedAt=null) for
// any given truck mirrors Truck.assignedOperatorId; the rest is history.
model TruckAssignmentEvent {
  id          String   @id @default(cuid())
  truckId     String
  operatorId  String
  assignedAt  DateTime @default(now())
  releasedAt  DateTime?

  truck       Truck    @relation(fields: [truckId], references: [id], onDelete: Cascade)
  operator    Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)

  @@index([truckId])
  @@index([operatorId])
  @@index([releasedAt])
}

// One row per active or revoked session. Cookie carries a random token; we
// store SHA-256(token) so a DB leak does not yield live session tokens.
model Session {
  id           String         @id @default(cuid())
  userId       String
  tokenHash    String         @unique
  userAgent    String?
  ipAddress    String?
  createdAt    DateTime       @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  events       SessionEvent[]

  @@index([userId])
  @@index([expiresAt])
}

// Login/logout audit with browser-captured location per proposal Section 2.1.
// locationError is set when the browser denied or failed geolocation.
model SessionEvent {
  id              String           @id @default(cuid())
  userId          String
  sessionId       String?
  type            SessionEventType
  occurredAt      DateTime         @default(now())

  latitude        Float?
  longitude       Float?
  accuracyMeters  Float?
  locationError   String?

  ipAddress       String?
  userAgent       String?

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  session         Session?         @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId, occurredAt])
  @@index([sessionId])
}

// Generic atomic counter for sequence-like values that need stronger control
// than a Postgres SEQUENCE (e.g. recoverable from outage, single source of
// truth across multi-region replicas). Phase 2 uses it for employee IDs.
model SystemCounter {
  key   String @id
  value Int    @default(0)
}

// Short-lived password reset tokens. tokenHash = SHA-256(rawToken).
model PasswordReset {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
